    {
      "name": "Internship Periods",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "List Internship Periods",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/internship-periods"
          }
        },
        {
          "name": "Get Internship Period",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/internship-periods/{{internship_period_id}}"
          }
        },
        {
          "name": "Get unknown Internship Period",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/internship-periods/999999999"
          }
        },
        {
          "name": "Create Internship Period",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{period_name}}\",\"description\":\"Postman test period\",\"start_date\":\"{{period_start_date}}\",\"end_date\":\"{{period_end_date}}\",\"status\":\"UPCOMING\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/internship-periods"
          }
        },
        {
          "name": "Update Internship Period",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{period_name}}\",\"description\":\"Updated by Postman\",\"start_date\":\"{{period_start_date}}\",\"end_date\":\"{{period_end_date}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/internship-periods/{{internship_period_id}}"
          }
        },
        {
          "name": "Update Internship Period Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"ACTIVE\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/internship-periods/{{internship_period_id}}/status"
          }
        },
        {
          "name": "Delete Internship Period",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/internship-periods/{{internship_period_id}}"
          }
        }
      ]
    },
    {
      "name": "Attachments",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{student_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{upload_file_path}}"
                },
                {
                  "key": "task_id",
                  "value": "{{task_id}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/attachments/upload"
          }
        },
        {
          "name": "Download Attachment",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/attachments/{{attachment_id}}"
          }
        },
        {
          "name": "Delete Attachment",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/attachments/{{attachment_id}}"
          }
        }
      ]
    }
  ]
}
