            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{create_user_email}}\",\"password\":\"{{create_user_password}}\",\"full_name\":\"{{create_user_name}}\",\"role\":\"STUDENT\",\"student_profile\":{\"student_code\":\"{{student_code}}\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Create Supervisor",
          "request": {
            "method": "POST",
            "header": [
