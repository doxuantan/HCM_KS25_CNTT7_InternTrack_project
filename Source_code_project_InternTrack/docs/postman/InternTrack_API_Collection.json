{
  "info": {
    "_postman_id": "6f96e970-1f30-4ead-9a7d-2f73f2343e8b",
    "name": "InternTrack_API_Collection",
    "description": "InternTrack APIs. Import and select InternTrack_Environment before running. Register creates a disposable STUDENT account; ADMIN and SUPERVISOR credentials and IDs must be configured for their requests. Logout is an acknowledgement only: access tokens remain valid until expiry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = {",
          "  'Register': 201, 'Register invalid email': 422, 'Register duplicate email': 409,",
          "  'Register missing fields': 422, 'Register invalid password': 422, 'Register password over bcrypt limit': 422,",
          "  'Register wrong type': 422, 'Register forged role': 422, 'Login': 200,",
          "  'Login wrong email': 401, 'Login wrong password': 401, 'Login invalid email': 422,",
          "  'Login missing password': 422, 'Login inactive account': 403, 'Login as Admin': 200,",
          "  'Login as Supervisor': 200, 'Get Current User': 200, 'Get Current User no token': 401,",
          "  'Get Current User malformed token': 401, 'Get Current User expired token': 401,",
          "  'Get Current User deleted account': 401, 'Get Current User inactive account': 403,",
          "  'Change Password wrong current': 400, 'Change Password invalid new password': 422,",
          "  'Change Password confirmation field': 422, 'Change Password no token': 401,",
          "  'Change Password invalid token': 401, 'Change Password inactive account': 403,",
          "  'Change Password': 200, 'Login with old password': 401, 'Login with new password': 200,",
          "  'Logout': 200, 'List Users as Student': 403, 'Get unknown User': 404,",
          "  'Create Student': 201, 'Create Supervisor': 201, 'Delete User': 204,",
          "  'List Internship Periods': 200, 'Get unknown Internship Period': 404,",
          "  'Create Internship Period': 201, 'Delete Internship Period': 204,",
          "  'Upload Attachment': 201, 'Download Attachment': 200, 'Delete Attachment': 204",
          "};",
          "pm.variables.set('expected_status', expected[pm.info.requestName] || 200);",
          "if (pm.info.requestName === 'Register') {",
          "  pm.environment.set('register_email', `student-${Date.now()}@example.test`);",
          "  if (!pm.environment.get('register_password')) pm.environment.set('register_password', `Auto_Test_${Date.now()}`);",
          "  if (!pm.environment.get('register_full_name')) pm.environment.set('register_full_name', 'Postman Test Student');",
          "}",
          "if (pm.info.requestName === 'Register password over bcrypt limit') pm.environment.set('long_password', 'L'.repeat(73));",
          "if (pm.info.requestName === 'Change Password' && !pm.environment.get('new_password')) {",
          "  pm.environment.set('new_password', `Changed_Test_${Date.now()}`);",
          "}",
          "if (pm.info.requestName === 'Change Password') pm.environment.set('old_password', pm.environment.get('login_password'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = Number(pm.variables.get('expected_status') || 200);",
          "const name = pm.info.requestName;",
          "pm.test(`HTTP ${expected}`, () => pm.response.to.have.status(expected));",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "if (expected === 204) {",
          "  pm.test('204 has no response body', () => pm.expect(pm.response.text()).to.eql(''));",
          "} else if (contentType.includes('application/json')) {",
          "  const body = pm.response.json();",
          "  pm.test('Standard response envelope', () => {",
          "    pm.expect(body).to.have.keys('success', 'message', 'data', 'errors');",
          "    pm.expect(body.message).to.be.a('string');",
          "    if (expected < 400) {",
          "      pm.expect(body.success).to.eql(true);",
          "      pm.expect(body.errors).to.eql(null);",
          "    } else {",
          "      pm.expect(body.success).to.eql(false);",
          "      pm.expect(body.data).to.eql(null);",
          "      pm.expect(body.errors).to.be.an('array');",
          "    }",
          "  });",
          "  if (expected < 400 && body.data && body.data.access_token) {",
          "    pm.environment.set('access_token', body.data.access_token);",
          "    const roleKey = `${body.data.user.role.toLowerCase()}_token`;",
          "    pm.environment.set(roleKey, body.data.access_token);",
          "  }",
          "  if (name === 'Register' && expected === 201) {",
          "    pm.environment.set('login_email', body.data.email);",
          "    pm.environment.set('login_password', pm.environment.get('register_password'));",
          "  }",
          "  if (name === 'Change Password' && expected === 200) {",
          "    pm.environment.set('login_password', pm.environment.get('new_password'));",
          "  }",
          "  if (name === 'Create Student' || name === 'Create Supervisor') pm.environment.set('user_id', body.data.id);",
          "  if (name === 'Create Internship Period') pm.environment.set('internship_period_id', body.data.id);",
          "  if (name === 'Upload Attachment') pm.environment.set('attachment_id', body.data.id);",
          "} else if (expected < 400) {",
          "  pm.test('Binary response has a download filename', () => pm.expect(pm.response.headers.get('Content-Disposition') || '').to.include('filename='));",
          "}"
        ]
      }
    }
  ],
