# ==============================================================================
# FILE .env.example - File mẫu để chia sẻ với team (KHÔNG có giá trị thật)
# ==============================================================================
# Hướng dẫn: Copy file này thành file ".env" rồi điền giá trị thật vào.
#   cp .env.example .env
# ==============================================================================

APP_ENV=development
DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
SECRET_KEY=<generate-a-random-secret-with-at-least-32-characters>
DEFAULT_ADMIN_PASSWORD=<replace-with-a-private-development-password>
SAMPLE_USER_PASSWORD=<replace-with-a-private-sample-password>
ALLOWED_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_ATTACHMENT_SIZE_MB=10
ATTACHMENT_STORAGE_DIR=storage/uploads